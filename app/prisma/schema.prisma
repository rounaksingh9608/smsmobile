generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  loginId   String?  @unique // name@flat
  phone     String?
  password  String?
  name      String
  role      String
  gender    String?
  apartment String?
  tower     String?
  societyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society   Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
  familyMembers FamilyMember[]
  vehicles      Vehicle[]
  invoices      Invoice[]
  bookings      FacilityBooking[]
  expenses      Expense[]
}

model Visitor {
  id        String   @id @default(cuid())
  name      String
  destination String
  status    String   // "Pending Approval", "Pre-Authorized", "Entered", "Denied"
  icon      String?
  img       String?
  age       Int?
  guestCount Int     @default(1)
  phone     String?
  qrToken   String?  @unique
  expiresAt DateTime?
  societyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society   Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
}

model EmergencyEvent {
  id        String   @id @default(cuid())
  type      String   // "SOS", "FIRE", "MEDICAL"
  status    String   // "ACTIVE", "RESOLVED"
  triggeredBy String // User role/name who triggered it
  societyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society   Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   // "INFO", "ALERT", "EVENT"
  author    String
  societyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society   Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
}

model Complaint {
  id        String   @id @default(cuid())
  title     String
  status    String   // "OPEN", "IN_PROGRESS", "RESOLVED"
  author    String
  societyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society   Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
}

model Society {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String?
  phone     String
  email     String
  password  String
  status    String   @default("ACTIVE") // "ACTIVE", "INACTIVE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  visitors         Visitor[]
  emergencyEvents  EmergencyEvent[]
  notices          Notice[]
  complaints       Complaint[]
  facilities       Facility[]
  expenses         Expense[]
}

model Facility {
  id          String   @id @default(cuid())
  name        String   // "Gym", "Swimming Pool", "Party Lawn"
  description String
  rate        Float    // Fixed price
  validity    String   // "Monthly", "Daily", etc.
  icon        String   // Material symbols icon name
  societyId   String?
  
  society     Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
  bookings    FacilityBooking[]
}

model FacilityBooking {
  id         String   @id @default(cuid())
  facilityId String
  userId     String   // Real foreign key
  date       DateTime // Booking start date
  endDate    DateTime? // Booking end date (for daily/event based)
  status     String   // "ACTIVE", "EXPIRED", "CANCELLED"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String   // Real foreign key
  title       String   // E.g., "Monthly Maintenance - September"
  amount      Float
  dueDate     DateTime
  status      String   // "PENDING", "PAID", "OVERDUE"
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id          String   @id @default(cuid())
  userId      String   // Real foreign key
  name        String
  relationship String  // E.g., "Spouse", "Child"
  age         Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id          String   @id @default(cuid())
  userId      String   // Real foreign key
  type        String   // "Car", "Bike"
  makeModel   String   // E.g., "Honda Civic"
  registration String  // E.g., "MH 12 AB 1234"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  title       String   
  amount      Float
  recipientId String   
  societyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  society     Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
}
